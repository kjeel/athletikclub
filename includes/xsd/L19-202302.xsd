<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:l19="urn:bmf.gv.at:efsz:l19:202302" targetNamespace="urn:bmf.gv.at:efsz:l19:202302" elementFormDefault="qualified" attributeFormDefault="unqualified">	<!--Rootelement der L19 Übermittlung-->	<xs:element name="L19" type="l19:L19Type"/>	<!--Rootelement der L19Storno Übermittlung-->	<xs:element name="L19Storno" type="l19:L19StornoType"/>	<xs:complexType name="L19Type">		<xs:sequence>			<xs:group ref="l19:KerndatenGroup"/>			<!--L19 Kennzahlen-->			<xs:element name="KENNZ" type="l19:KennzahlenType"/>		</xs:sequence>	</xs:complexType>	<xs:complexType name="L19StornoType">		<xs:sequence>			<xs:group ref="l19:KerndatenGroup"/>		</xs:sequence>	</xs:complexType>	<!--XSD Group, die alle XSD Elemente zusammenfasst, die sowohl in einem L19- als auch in einem L19Storno-Rootelement vorkommen müssen-->	<xs:group name="KerndatenGroup">		<xs:sequence>			<!--Referenznummer-->			<xs:element name="REFNR" type="l19:StringMaxLength100Type"/>			<!--Timestamp Ausstellung L19-->			<xs:element name="TSAUS" type="xs:dateTime"/>			<!--Beginn des Zeitraumes-->			<xs:element name="BLZ" type="l19:L19ZeitraumType"/>			<!--Ende des Zeitraumes-->			<xs:element name="ELZ" type="l19:L19ZeitraumType"/>			<!--Auszahler-->			<xs:element name="AUSZ" type="l19:AuszahlerType"/>			<!--Empfaenger-->			<xs:element name="EMPF" type="l19:EmpfaengerType"/>		</xs:sequence>	</xs:group>	<xs:simpleType name="L19ZeitraumType">		<xs:restriction base="xs:date">			<xs:minInclusive value="2023-01-01"/>		</xs:restriction>	</xs:simpleType>	<xs:complexType name="AuszahlerType">		<xs:sequence>			<!--Zahl des zentralen Vereinsregisters des Auszahlers-->			<xs:element name="ZVR" type="l19:ZvrType"/>			<!--Steuernummer des Auszahlers-->			<xs:element name="STN" type="l19:StnrType" minOccurs="0"/>			<!--Adresse des Auszahlers-->			<xs:element name="ADR" type="l19:AdresseType" minOccurs="0"/>			<!--Name des Auszahlers-->			<xs:element name="NAM" type="l19:StringMaxLength1000Type" minOccurs="0"/>		</xs:sequence>	</xs:complexType>	<xs:complexType name="EmpfaengerType">		<xs:sequence>			<xs:choice>				<xs:sequence>					<!--Sozialversicherungsnummer des Empfängers-->					<xs:element name="SVN" type="l19:SvnrType"/>					<!--Geburtsdatum des Empfängers-->					<xs:element name="GBD" type="xs:date" minOccurs="0"/>					<!--Adresse des Empfängers-->					<xs:element name="ADR" type="l19:AdresseType" minOccurs="0"/>				</xs:sequence>				<xs:sequence>					<!--Geburtsdatum des Empfängers-->					<xs:element name="GBD" type="xs:date"/>					<!--Adresse des Empfängers-->					<xs:element name="ADR" type="l19:AdresseType"/>				</xs:sequence>			</xs:choice>			<!--Vorname des Empfängers-->			<xs:element name="VNAM" type="l19:StringMaxLength1000Type"/>			<!--Familien oder Nachname des Empfängers-->			<xs:element name="FNAM" type="l19:StringMaxLength1000Type"/>		</xs:sequence>	</xs:complexType>	<xs:complexType name="KennzahlenType">		<xs:sequence>			<!--Pauschale Reiseaufwandsentschädigungen für eine nichtselbständige Tätigkeit gemäß § 3 Abs. 1 Z 16c-->			<xs:element name="PRAE" type="l19:PraeType"/>		</xs:sequence>	</xs:complexType>	<xs:complexType name="AdresseType">		<xs:sequence>			<!--Land-Code gemäß dem Standard ISO 3166 Alpha-2-->			<xs:element name="LND" type="l19:LNDType"/>			<!--Ort-->			<xs:element name="ORT" type="l19:StringMaxLength1000Type"/>			<!--Postleitzahl-->			<xs:element name="PLZ" type="l19:StringMaxLength10Type"/>			<!--Straße inkl. Hausnummer und ggfs. Stiege, Tür usw.-->			<xs:element name="STR" type="l19:StringMaxLength1000Type"/>		</xs:sequence>	</xs:complexType>	<xs:simpleType name="LNDType">		<xs:restriction base="xs:string">			<xs:pattern value="[A-Z]{2}"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="StringMaxLength10Type">		<xs:restriction base="xs:string">			<xs:maxLength value="10"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="StringMaxLength100Type">		<xs:restriction base="xs:string">			<xs:maxLength value="100"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="StringMaxLength1000Type">		<xs:restriction base="xs:string">			<xs:maxLength value="1000"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="SvnrType">		<xs:restriction base="xs:string">			<xs:pattern value="[1-9]([0-9]{9})"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="ZvrType">		<xs:restriction base="xs:string">			<xs:pattern value="[0-9]{10}"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="StnrType">		<xs:restriction base="xs:string">			<xs:pattern value="[0-9]{9}"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="PraeType">		<xs:restriction base="xs:decimal">			<xs:pattern value="\d{1,8}(\.\d{1,2})?"/>		</xs:restriction>	</xs:simpleType></xs:schema>