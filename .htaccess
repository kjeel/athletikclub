# Athletikclub Steiermark – Webhosting

# HTTPS erzwingen (Hetzner Webhosting L)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www erzwingen (optional)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================================
# URL-Rewriting (saubere URLs ohne .php-Endung)
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

# Startseite
RewriteRule ^$ /index.php [L]

# ============================================================
# Verzeichniszugriff sperren
# ============================================================
Options -Indexes

# ============================================================
# Sensitive Verzeichnisse schützen
# ============================================================

# Config-Ordner komplett sperren
<FilesMatch "^(config|sql|includes)">
    Order deny,allow
    Deny from all
</FilesMatch>

# SQL-Dateien direkt sperren
<Files "*.sql">
    Order deny,allow
    Deny from all
</Files>

# .env sperren (falls vorhanden)
<Files ".env">
    Order deny,allow
    Deny from all
</Files>

# ============================================================
# Upload-Verzeichnis: Kein PHP-Ausführen
# ============================================================
<IfModule mod_php7.c>
    <Directory "uploads">
        php_flag engine off
    </Directory>
</IfModule>

# ============================================================
# Security Headers
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================================
# Caching (Performance)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png            "access plus 6 months"
    ExpiresByType image/jpeg           "access plus 6 months"
    ExpiresByType image/webp           "access plus 6 months"
    ExpiresByType image/svg+xml        "access plus 1 month"
    ExpiresByType image/gif            "access plus 6 months"
    ExpiresByType application/pdf      "access plus 1 week"
    ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

# ============================================================
# Komprimierung
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml
</IfModule>

# ============================================================
# Fehlerseiten
# ============================================================
ErrorDocument 403 /pages/error.php?code=403
ErrorDocument 404 /pages/error.php?code=404
ErrorDocument 500 /pages/error.php?code=500
