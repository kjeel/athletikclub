# ============================================================
#  Athletikclub Steiermark – Beispiel-Umgebungsvariablen
#  Kopiere diese Datei zu .env und trage die echten Werte ein.
#  cp .env.example .env
# ============================================================

# App-Einstellungen
APP_ENV=production
APP_URL=https://www.athletikclub-steiermark.at
APP_NAME="Athletikclub Steiermark"

# Datenbank (Hetzner MySQL / MariaDB)
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Hetzner SSH
HETZNER_SSH_HOST=
HETZNER_SSH_PORT=22
HETZNER_SSH_USER=
HETZNER_SSH_PASS=
HETZNER_SSH_KEY_PATH=~/.ssh/id_rsa_athletikclub

# Hetzner FTP
HETZNER_FTP_HOST=
HETZNER_FTP_PORT=21
HETZNER_FTP_USER=
HETZNER_FTP_PASS=

# Webroot-Pfad auf dem Server
HETZNER_WEBROOT=/home/uXXXXXXXXX/www

# E-Mail / SMTP
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=noreply@athletikclub-steiermark.at
MAIL_FROM_NAME="Athletikclub Steiermark"
MAIL_ADMIN=office@athletikclub-steiermark.at

# Hetzner API (optional)
HETZNER_API_KEY=
